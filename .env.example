# Copie este archivo como .env.local y complete los valores. NUNCA suba .env.local al repositorio.

# Conexión a PostgreSQL 18 (usuario, contraseña, servidor, puerto y base de datos).
DATABASE_URL="postgresql://admin_sst:CAMBIAR_CLAVE@localhost:5432/sst_inspecciones"

# Firma de las sesiones: texto aleatorio de 32 caracteres o más, distinto en cada servidor.
# Para generarlo:  openssl rand -base64 48
SESSION_SECRET="CAMBIAR_POR_UN_TEXTO_ALEATORIO_LARGO"

# Zona horaria: el sistema calcula "hoy" (pendientes, atrasados, formularios del día) con la hora del servidor.
TZ="America/Caracas"

# Carpeta donde se guardan las fotos y firmas de los formularios (debe persistir y respaldarse).
ARCHIVOS_DIR="/var/lib/sistema-cronogramas/archivos"

# Solo si el sistema se usa SIN https (por ejemplo, red interna con http://). Con https, borre esta línea.
# COOKIE_INSEGURA="1"

# Solo para crear el primer administrador con `bun run db:crear-admin` (instalación desde cero sin datos).
# ADMIN_NOMBRE="Administrador"
# ADMIN_CORREO="admin@empresa.com"
# ADMIN_CLAVE="ClaveTemporal123"
