# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fotos subidas en formularios (datos, no código)
/almacenamiento

# documentos de referencia (formatos oficiales, Excel de la herramienta, PDF) y capturas de diseño:
# no forman parte del código; se guardan fuera del repositorio
*.docx
*.xlsx
*.pdf
/estilo/
/cronogramas_comoson/

# datos para migrar a un servidor (esquema SQL y plantillas de formularios)
!/migracion/

# plantilla de variables de entorno (sin secretos): sí va al repositorio
!.env.example

# Herramientas de IA y desarrollo local (permanecen en PC local, fuera de GitHub)
.agents/
skills-lock.json
AGENTS.md
CLAUDE.md
docs/superpowers/
scripts/analizar_docx.py
scripts/extraer_excel.py
scripts/generar_todos_formularios.py

# Guias de despliegue internas y checklists (solo en PC local)
